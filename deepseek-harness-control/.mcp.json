{
  "mcpServers": {
    "deepseek_harness": {
      "command": "node",
      "args": ["./lib/server.js"],
      "cwd": ".",
      "enabled": true,
      "default_tools_approval_mode": "prompt",
      "tools": {
        "status": { "approval_mode": "approve" },
        "result": { "approval_mode": "approve" }
      },
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 3600
    }
  }
}
